# ---- Server ----
MANAGER_HOST=0.0.0.0
MANAGER_PORT=9000
HOST_IP=                     # IP advertised to NVRs in Port Mode (empty = auto-detect)
WSD_INTERFACE_IP=            # NIC for WS-Discovery multicast (empty = HOST_IP)
LOG_LEVEL=INFO

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
MANAGER_AUTH_ENABLED=true
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin

# ---- Cameras ----
ADDR_MODE=port               # port | ip  (ip = v1.1)
CAM_PORT_RANGE=8001-8999
CAM_IP_RANGE=192.168.1.201-192.168.1.250
CAM_DEFAULT_USER=admin
CAM_DEFAULT_PASSWORD=admin123
REBOOT_SECONDS=20
START_BATCH_SIZE=10

# ---- Media ----
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
CACHE_JOB_WORKERS=2
X264_PRESET=veryfast

# ---- ONVIF ----
WSSEC_TIME_TOLERANCE_S=300   # 0 disables the WS-Security Created-time check
MAX_SUBSCRIPTIONS_PER_CAMERA=20
WSD_ENABLED=true
