# =======================================================================================
# VirtualCamX settings - ONE file for both ways of running:
#   - local:  copy to vcam_server/.env, then `py main.py`
#   - Docker: the same vcam_server/.env is read by deploy/docker-compose*.yml
#             (docker compose --env-file ../vcam_server/.env up -d)
# Every key is optional; the value shown is the built-in default.
# Keep comments on their own lines (Docker's env-file parser does not strip inline comments).
# =======================================================================================

# ---- Server ---------------------------------------------------------------------------
MANAGER_HOST=0.0.0.0
MANAGER_PORT=9000
# IP advertised to NVRs (ONVIF/RTSP URLs). Empty = auto-detect.
# Required for Docker bridge mode (Docker Desktop): set it to this PC's LAN IP.
HOST_IP=
# Network card used for WS-Discovery multicast. Empty = HOST_IP.
WSD_INTERFACE_IP=
LOG_LEVEL=INFO
# Relative paths are relative to vcam_server/ (Docker always uses /data and /app/bin)
DATA_DIR=data
BIN_DIR=bin

# ---- Security -------------------------------------------------------------------------
# Signs Manager login tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
MANAGER_AUTH_ENABLED=true
# Only used to create the first admin (you must change the password at first login)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin
ACCESS_TOKEN_MINUTES=720

# ---- Cameras --------------------------------------------------------------------------
# port = one port per camera on HOST_IP (ip mode is planned for v1.1)
ADDR_MODE=port
CAM_PORT_RANGE=8001-8999
CAM_IP_RANGE=192.168.1.201-192.168.1.250
CAM_BIND_HOST=0.0.0.0
# Login given to new cameras
CAM_DEFAULT_USER=admin
CAM_DEFAULT_PASSWORD=admin123
# How long a camera stays offline when rebooted
REBOOT_SECONDS=20
# Cameras started at the same time when the server starts
START_BATCH_SIZE=10

# ---- Media ----------------------------------------------------------------------------
MEDIAMTX_RTSP_PORT=8554
# RTSP transports offered to NVRs. Docker bridge mode forces "tcp" (UDP video can't cross Docker's NAT).
RTSP_TRANSPORTS=udp,multicast,tcp
# RTSP over UDP: RTP port (RTCP = +1). Change both if another MediaMTX (e.g. an NVR) uses 8000/8001.
MEDIAMTX_RTP_PORT=8000
# RTSP multicast: RTP port (RTCP = +1)
MEDIAMTX_MULTICAST_PORT=8002
MEDIAMTX_WEBRTC_PORT=8889
# UDP port for browser live video (allow it in the firewall)
MEDIAMTX_WEBRTC_UDP_PORT=8189
# MediaMTX control API (localhost only)
MEDIAMTX_API_PORT=9997
# First local port for live FFmpeg control (one per camera, localhost only)
ZMQ_BASE_PORT=21000
CACHE_JOB_WORKERS=2
SNAPSHOT_MAX_PARALLEL=4
# ultrafast | superfast | veryfast | faster | fast | medium  (faster = less CPU, bigger streams)
X264_PRESET=veryfast

# ---- ONVIF ----------------------------------------------------------------------------
# Allowed clock difference for WS-Security (seconds). 0 = do not check.
WSSEC_TIME_TOLERANCE_S=300
MAX_SUBSCRIPTIONS_PER_CAMERA=20
INSPECTOR_BUFFER_PER_CAMERA=2000
WSD_ENABLED=true

# ---- Docker only (ignored by the server) ----------------------------------------------
# Image name/tag used by docker compose
VCAMX_IMAGE=vcamx:latest
# Host folder with your footage, mounted read-only at /media (use /media/... paths in the UI).
# Relative paths are relative to deploy/.
VCAMX_MEDIA_DIR=./media
# Bridge mode only: camera ports published by Docker (must stay inside CAM_PORT_RANGE)
DOCKER_CAM_PORTS=8004-8063
# Container time zone
TZ=UTC
